<?xml version="1.0" encoding="utf-8"?>
<!-- Hermes screen for an Echo Show running echo-dot-assist: one full-screen WebView showing the
     page hermes_voice serves (docs/show-screen.md). No microphone, camera or storage: network only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.hermesvoice.screen"
    android:versionCode="2"
    android:versionName="0.2.0">

    <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="25" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Hermes Screen"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
